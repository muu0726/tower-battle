{
  "name": "tower-battle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tower-battle-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tower-battle-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "play": "node scripts/play.mjs",
    "tunnel": "node scripts/play.mjs --dev"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "matter-js": "^0.20.0",
    "poly-decomp": "^0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
